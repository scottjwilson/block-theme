{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        {
          "slug": "navy",
          "color": "#1a2744",
          "name": "Navy"
        },
        {
          "slug": "navy-light",
          "color": "#2a3a5c",
          "name": "Navy Light"
        },
        {
          "slug": "navy-dark",
          "color": "#0f1a2e",
          "name": "Navy Dark"
        },
        {
          "slug": "amber",
          "color": "#d4a24c",
          "name": "Amber"
        },
        {
          "slug": "amber-light",
          "color": "#e8c078",
          "name": "Amber Light"
        },
        {
          "slug": "amber-dark",
          "color": "#916b20",
          "name": "Amber Dark"
        },
        {
          "slug": "cream",
          "color": "#faf8f5",
          "name": "Cream"
        },
        {
          "slug": "cream-dark",
          "color": "#f0ebe3",
          "name": "Cream Dark"
        },
        {
          "slug": "sand",
          "color": "#e8e0d4",
          "name": "Sand"
        },
        {
          "slug": "stone",
          "color": "#9a918a",
          "name": "Stone"
        },
        {
          "slug": "charcoal",
          "color": "#3d3a37",
          "name": "Charcoal"
        },
        {
          "slug": "charcoal-light",
          "color": "#5c5753",
          "name": "Charcoal Light"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "White"
        },
        {
          "slug": "sea",
          "color": "#4a7c8c",
          "name": "Sea"
        },
        {
          "slug": "sea-light",
          "color": "#6a9cac",
          "name": "Sea Light"
        }
      ],
      "gradients": [
        {
          "slug": "amber-glow",
          "gradient": "radial-gradient(ellipse at 80% 20%, rgba(212, 162, 76, 0.15) 0%, transparent 60%)",
          "name": "Amber Glow"
        },
        {
          "slug": "cream-sand",
          "gradient": "linear-gradient(135deg, #faf8f5 0%, #e8e0d4 100%)",
          "name": "Cream to Sand"
        },
        {
          "slug": "navy-sea",
          "gradient": "linear-gradient(90deg, #1a2744 0%, #4a7c8c 100%)",
          "name": "Navy to Sea"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'DM Serif Display', Georgia, serif",
          "slug": "display",
          "name": "Display"
        },
        {
          "fontFamily": "'Outfit', -apple-system, BlinkMacSystemFont, sans-serif",
          "slug": "body",
          "name": "Body"
        },
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
          "slug": "system",
          "name": "System"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "size": "clamp(0.75rem, 0.7rem + 0.25vw, 0.8125rem)",
          "name": "Extra Small"
        },
        {
          "slug": "small",
          "size": "clamp(0.8125rem, 0.75rem + 0.3vw, 0.9375rem)",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "clamp(1rem, 0.95rem + 0.25vw, 1.0625rem)",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "clamp(1.125rem, 1rem + 0.5vw, 1.25rem)",
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem)",
          "name": "Extra Large"
        },
        {
          "slug": "xx-large",
          "size": "clamp(1.5rem, 1.25rem + 1.25vw, 2rem)",
          "name": "2X Large"
        },
        {
          "slug": "3x-large",
          "size": "clamp(2rem, 1.5rem + 2.5vw, 3rem)",
          "name": "3X Large"
        },
        {
          "slug": "4x-large",
          "size": "clamp(2.5rem, 1.75rem + 3.75vw, 4rem)",
          "name": "4X Large"
        },
        {
          "slug": "5x-large",
          "size": "clamp(3rem, 2rem + 5vw, 5rem)",
          "name": "5X Large"
        }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw", "vh"],
      "customSpacingSize": true,
      "spacingScale": {
        "steps": 0
      },
      "spacingSizes": [
        {
          "slug": "xs",
          "size": "0.5rem",
          "name": "XS"
        },
        {
          "slug": "sm",
          "size": "1rem",
          "name": "SM"
        },
        {
          "slug": "md",
          "size": "1.5rem",
          "name": "MD"
        },
        {
          "slug": "lg",
          "size": "2rem",
          "name": "LG"
        },
        {
          "slug": "xl",
          "size": "3rem",
          "name": "XL"
        },
        {
          "slug": "2xl",
          "size": "5rem",
          "name": "2XL"
        },
        {
          "slug": "3xl",
          "size": "8rem",
          "name": "3XL"
        }
      ]
    },
    "layout": {
      "contentSize": "800px",
      "wideSize": "1400px"
    },
    "custom": {
      "contentWidth": "1200px",
      "narrowWidth": "800px",
      "borderRadius": {
        "sm": "4px",
        "md": "8px",
        "lg": "12px",
        "xl": "20px",
        "full": "9999px"
      },
      "transition": {
        "fast": "150ms",
        "base": "300ms",
        "slow": "500ms",
        "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)",
        "easeInOut": "cubic-bezier(0.65, 0, 0.35, 1)"
      },
      "shadow": {
        "sm": "0 1px 3px rgba(26, 39, 68, 0.06), 0 1px 2px rgba(26, 39, 68, 0.04)",
        "md": "0 4px 12px rgba(26, 39, 68, 0.08), 0 2px 4px rgba(26, 39, 68, 0.04)",
        "lg": "0 12px 40px rgba(26, 39, 68, 0.12), 0 4px 12px rgba(26, 39, 68, 0.06)",
        "xl": "0 24px 60px rgba(26, 39, 68, 0.16), 0 8px 20px rgba(26, 39, 68, 0.08)",
        "glow": "0 0 40px rgba(212, 162, 76, 0.2)"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--cream)",
      "text": "var(--wp--preset--color--charcoal)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--lg)"
    },
    "elements": {
      "link": {
        "color": {
          "text": "inherit"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--amber-dark)"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--navy)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.2"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--4x-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--3x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--amber)",
          "text": "var(--wp--preset--color--navy-dark)"
        },
        "border": {
          "radius": "var(--wp--custom--border-radius--sm)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "600"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--amber-dark)"
          }
        }
      }
    }
  }
}
