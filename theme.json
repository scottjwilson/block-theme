{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        {
          "slug": "primary",
          "color": "#E85A3C",
          "name": "Primary"
        },
        {
          "slug": "primary-dark",
          "color": "#D14A2D",
          "name": "Primary Dark"
        },
        {
          "slug": "primary-light",
          "color": "#FDF8F3",
          "name": "Primary Light"
        },
        {
          "slug": "secondary",
          "color": "#1E3D59",
          "name": "Secondary"
        },
        {
          "slug": "accent",
          "color": "#2E8B7B",
          "name": "Accent"
        },
        {
          "slug": "harbor",
          "color": "#1E3D59",
          "name": "Harbor"
        },
        {
          "slug": "ink",
          "color": "#1A2E3F",
          "name": "Ink"
        },
        {
          "slug": "mist",
          "color": "#5A6D7A",
          "name": "Mist"
        },
        {
          "slug": "mist-light",
          "color": "#F5F5F5",
          "name": "Mist Light"
        },
        {
          "slug": "canvas",
          "color": "#ffffff",
          "name": "Canvas"
        },
        {
          "slug": "cream",
          "color": "#FDF8F3",
          "name": "Cream"
        }
      ],
      "gradients": [
        {
          "slug": "primary-gradient",
          "gradient": "linear-gradient(135deg, #FDF8F3 0%, #F8EDE3 100%)",
          "name": "Primary Gradient"
        },
        {
          "slug": "hero-gradient",
          "gradient": "linear-gradient(135deg, #1E3D59 0%, #2E8B7B 100%)",
          "name": "Hero Gradient"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
          "slug": "system",
          "name": "System"
        },
        {
          "fontFamily": "'Georgia', 'Times New Roman', serif",
          "slug": "serif",
          "name": "Serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "1rem",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "1.25rem",
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "1.5rem",
          "name": "Extra Large"
        },
        {
          "slug": "xx-large",
          "size": "2rem",
          "name": "2X Large"
        },
        {
          "slug": "huge",
          "size": "clamp(2.5rem, 5vw, 3.5rem)",
          "name": "Huge"
        }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw", "vh"],
      "spacingSizes": [
        {
          "slug": "10",
          "size": "0.25rem",
          "name": "1"
        },
        {
          "slug": "20",
          "size": "0.5rem",
          "name": "2"
        },
        {
          "slug": "30",
          "size": "1rem",
          "name": "3"
        },
        {
          "slug": "40",
          "size": "1.5rem",
          "name": "4"
        },
        {
          "slug": "50",
          "size": "2rem",
          "name": "5"
        },
        {
          "slug": "60",
          "size": "3rem",
          "name": "6"
        },
        {
          "slug": "70",
          "size": "4rem",
          "name": "7"
        },
        {
          "slug": "80",
          "size": "6rem",
          "name": "8"
        }
      ]
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1120px"
    },
    "custom": {
      "container": "1120px",
      "borderRadius": {
        "small": "4px",
        "medium": "8px",
        "large": "16px"
      },
      "transition": {
        "fast": "0.2s ease",
        "medium": "0.3s ease"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--canvas)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--40)"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--harbor)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary-dark)"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--ink)"
        },
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.2"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--huge)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--canvas)"
        },
        "border": {
          "radius": "var(--wp--custom--border-radius--medium)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary-dark)"
          }
        }
      }
    }
  }
}
