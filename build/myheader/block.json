{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "myblocks/myheader",
  "version": "0.1.0",
  "title": "Header",
  "category": "widgets",
  "icon": "admin-home",
  "description": "Harbor Light header with navigation and logo.",
  "example": {},
  "supports": {
    "html": false
  },
  "attributes": {
    "logoText": {
      "type": "string",
      "default": "Harbor Light"
    },
    "navLinks": {
      "type": "array",
      "default": [
        {
          "label": "About",
          "url": "/#about"
        },
        {
          "label": "Programs",
          "url": "/#programs"
        },
        {
          "label": "Impact",
          "url": "/#impact"
        },
        {
          "label": "Stories",
          "url": "/#stories"
        },
        {
          "label": "Contact",
          "url": "/#contact"
        }
      ]
    },
    "volunteerText": {
      "type": "string",
      "default": "Volunteer"
    },
    "volunteerUrl": {
      "type": "string",
      "default": "/volunteer/"
    },
    "donateText": {
      "type": "string",
      "default": "Donate"
    },
    "donateUrl": {
      "type": "string",
      "default": "/#contact"
    }
  },
  "textdomain": "myheader",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}